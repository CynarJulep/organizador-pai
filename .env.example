# Copy this file to .env and replace every placeholder.
# .env is gitignored. Do not commit real values.

PORT=3000
NODE_ENV=development

# Random string, at least 16 characters. Used to sign session cookies.
SESSION_SECRET=replace-with-a-long-random-string

# Accounts created on first launch when they do not already exist.
# Keep the usernames or change them. Replace every password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-your-own-password
OPERATOR_USERNAME=operador1
OPERATOR_PASSWORD=replace-with-your-own-password
SUPERVISOR_USERNAME=supervisor1
SUPERVISOR_PASSWORD=replace-with-your-own-password

# Optional. Used only by whatsapp-server-greenapi/.
# GREEN_API_ID=
# GREEN_API_TOKEN=
